{
  "name": "@content2quiz/api",
  "description": "QuizFromContent",
  "version": "0.1.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 23.8.0"
  },
  "feathers": {
    "language": "ts",
    "packager": "pnpm",
    "database": "postgresql",
    "framework": "koa",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "lib/client",
  "scripts": {
    "dev": "nodemon -x ts-node src/index.ts",
    "compile": "shx rm -rf lib/ && tsc",
    "start": "node lib/",
    "prettier": "npx prettier \"**/*.ts\" --write",
    "mocha": "cross-env NODE_ENV=test mocha test/ --require ts-node/register --recursive --extension .ts --exit",
    "test": "cross-env NODE_ENV=test npm run migrate && npm run mocha",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.37",
    "@feathersjs/authentication-client": "^5.0.37",
    "@feathersjs/configuration": "^5.0.37",
    "@feathersjs/errors": "^5.0.37",
    "@feathersjs/feathers": "^5.0.37",
    "@feathersjs/knex": "^5.0.37",
    "@feathersjs/koa": "^5.0.37",
    "@feathersjs/schema": "^5.0.37",
    "@feathersjs/socketio": "^5.0.37",
    "@feathersjs/transport-commons": "^5.0.37",
    "@feathersjs/typebox": "^5.0.37",
    "@koa/router": "^14.0.0",
    "@openrouter/ai-sdk-provider": "^1.2.3",
    "@types/formidable": "^3.4.6",
    "feathers-swagger": "^3.0.0",
    "formidable": "^3.5.4",
    "knex": "^3.1.0",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-dist": "^5.30.2",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@feathersjs/authentication": "^5.0.37",
    "@feathersjs/cli": "5.0.37",
    "@feathersjs/rest-client": "^5.0.37",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "axios": "^1.13.2",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}